# Copy to .env and adjust. Every variable is optional; the values shown are the defaults.

# --- safety ---
# true  = go up to the final submit/send click, screenshot, stop. NEVER submits.
# false = submit only when the auto-submit gate passes (Phase 3).
DRY_RUN=true
# Run the browser headless (false = you see the window; recommended).
HEADLESS=false

# --- paths / server ---
# All personal data lives here (gitignored): DB, logs, screenshots, browser profile, CV, profile.
DATA_DIR=data
# preferences file (relative to the repo root); empty = data/preferences.yaml
PREFERENCES_FILE=
# optional profile file instead of data/profile/profile.json (e.g. data/profile/profile.draft.json to try a draft)
PROFILE_FILE=
PORT=8787
LOG_LEVEL=info

# --- language model (the Settings screen edits this section) ---
# Provider per task: ollama (local, default) | anthropic | openai | gemini | fake (test mode, no model)
# analyze = scoring, question→answer matching, JSON extraction (many calls)
LLM_ANALYZE_PROVIDER=ollama
# empty = OLLAMA_MODEL_ANALYZE for ollama; required for API providers
LLM_ANALYZE_MODEL=
# write = Hebrew/English free-text drafts (few calls)
LLM_WRITE_PROVIDER=ollama
LLM_WRITE_MODEL=
# API keys: kept only in this file — never stored in the DB, logged, or shown in full in the UI
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
# Pause LLM steps for the rest of the day after this many API tokens (0/empty = no limit; Ollama is never limited)
DAILY_LLM_TOKEN_LIMIT=

# --- Ollama (local) ---
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL_ANALYZE=gemma4:12b
OLLAMA_MODEL_WRITE=gemma4:12b
OLLAMA_TIMEOUT_MS=180000
# Comma-separated models for `npm run model:bench`: provider:model (a bare name = ollama), e.g.
# BENCH_MODELS=gemma4:12b,anthropic:claude-sonnet-5-5,openai:<model-id>,gemini:<model-id>
BENCH_MODELS=gemma4:12b

# --- pacing / limits (preferences.yaml `limits`/`thresholds` override these) ---
# "load more" pages per search query per run
MAX_PAGES_PER_RUN=3
DAILY_APPLY_LIMIT=15
AUTO_SUBMIT_MIN_SCORE=80
MATCH_CONFIDENCE=0.85
COMPANY_COOLDOWN_DAYS=30
# cross-site dedupe window (same company + normalized title)
DEDUPE_WINDOW_DAYS=14
# Use the English CV only if Hebrew letters are below this share of all letters in the post
ENGLISH_CV_MAX_HEBREW_RATIO=0.2
# random delay between page actions, ms
PACE_MIN_MS=2500
PACE_MAX_MS=7000
